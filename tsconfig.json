{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "include": ["src/**/*", "demo/**/*", "tests/**/*", "index.ts"],
    "resolveJsonModule": true,
    "declaration": true,
    "types": ["node"]
  }
}
